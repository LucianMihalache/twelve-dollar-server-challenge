{
    "name": "lucianmihalache/twelve-dollar-feed",
    "description": "The $12 server challenge API on Laravel Octane and FrankenPHP.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "laravel/framework": "13.34.0",
        "laravel/octane": "2.20.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
